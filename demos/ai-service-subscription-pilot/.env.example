# Browser-safe Vite variables
# TASK-0005: only the Supabase URL/publishable key are supplied to the Vite build.
# Existing PayPal browser configuration is outside TASK-0005; leave it unchanged.
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_PAYPAL_CLIENT_ID=replace_me

# Base server configuration
# Render owns these runtime values; APP_URL is the service HTTPS origin and
# determines Secure cookies. Render supplies PORT. Never use VITE_ for secrets.
APP_URL=http://127.0.0.1:3000
PORT=3000
DATABASE_URL=postgresql://postgres.project-ref:replace_me@host:6543/postgres
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
DEMO_SESSION_SIGNING_SECRET=replace_with_at_least_32_characters

# PayPal capability configuration (loaded only by its owning adapter)
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_MERCHANT_ID=replace_me
PAYPAL_WEBHOOK_ID=replace_me
PAYPAL_ENVIRONMENT=sandbox

# Email-hook capability configuration (loaded only by its owning adapter)
# Server runtime only. Keep all three absent for the initial contained-failure
# gate, then configure them through the secure provider settings, not this file.
# Hook endpoint: APP_URL + /webhooks/supabase/send-email. Use the matching
# Standard Webhooks secret and an already verified Resend sender.
# Missing capability must not disable health or the compiled customer UI.
SUPABASE_SEND_EMAIL_HOOK_SECRET=v1,whsec_replace_me
RESEND_API_KEY=re_replace_me
EMAIL_FROM_ADDRESS=AI Service Demo <demo@example.test>
